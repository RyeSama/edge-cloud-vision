# Copy to .env and edit. Never commit .env.
ECV_MQTT_HOST=127.0.0.1
ECV_MQTT_PORT=1883
ECV_DEVICE_ID=edge-cam-01
ECV_CLOUD_CLIENT_ID=ecv-cloud

# OpenAI-compatible LLM endpoint. DeepSeek example:
ECV_LLM_BASE_URL=https://api.deepseek.com/v1
ECV_LLM_API_KEY=
ECV_LLM_MODEL=deepseek-chat
ECV_LLM_TIMEOUT_S=8
# Optional explicit proxy (httpx does not read HTTP_PROXY/NO_PROXY otherwise).
# ECV_LLM_PROXY=http://127.0.0.1:7890

# Edge-Mem v0.2: SQLite + optional Chroma, temporal decay and hybrid retrieval.
ECV_MEMORY_DB_PATH=data/edge_mem.sqlite3
ECV_MEMORY_TIMEZONE=Asia/Shanghai
ECV_MEMORY_HOT_MINUTES=10
ECV_MEMORY_WARM_HOURS=2
ECV_MEMORY_BUCKET_MINUTES=15
ECV_MEMORY_TOKEN_BUDGET=4000
# memory (default, zero extra deps) or chroma (pip install -e ".[memory]")
ECV_MEMORY_VECTOR_BACKEND=memory
ECV_MEMORY_CHROMA_PATH=data/chroma
ECV_MEMORY_VECTOR_DIM=256
ECV_MEMORY_AUTO_COMPRESS=1
